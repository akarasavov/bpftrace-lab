<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.neo4j.build</groupId>
  <artifactId>lucene-page-cache</artifactId>
  <version>1.0-SNAPSHOT</version>
  <build>
    <finalName>index-manager</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>index-manager</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>index-manager</finalName>
              <transformers>
                <transformer>
                  <mainClass>com.neo4j.build.IndexManager</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>page-cache-monitor</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>page-cache-monitor</finalName>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>monitor</shadedClassifierName>
              <transformers>
                <transformer>
                  <mainClass>com.neo4j.build.PageCacheMonitor</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.target>25</maven.compiler.target>
    <maven.compiler.source>25</maven.compiler.source>
  </properties>
</project>
